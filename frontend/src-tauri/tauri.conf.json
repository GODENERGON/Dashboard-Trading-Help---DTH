{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dabitur",
  "version": "0.1.0",
  "identifier": "com.godenergon.dabitur",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dabitur",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "backgroundColor": "#101A2A"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'wasm-unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Dabitur",
    "shortDescription": "Supporto alle decisioni di investimento",
    "longDescription": "Dabitur raccoglie prezzi, prodotti e rischi in un solo posto. Strumento di informazione, non consulenza finanziaria.",
    "copyright": "Effetto metallo liquido: Paper Shaders, copyright Lost Coast Labs, Inc. (paper.design)",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "engine/": "backend/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Italian"],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  }
}
